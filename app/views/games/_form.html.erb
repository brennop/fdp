<%= turbo_frame_tag :move_form do %>
  <% if player.in_turn? %>
    <p>your turn</p>
  <% end %>

  <%= form_with model: Move.new(game: game), url: move_path(game), class: "p-4 flex justify-between items-center" do |form| %>
    <%= form.hidden_field :game_id %>

    <% if state.bidding_phase? %>
      <%= form.collection_radio_buttons :value, (0..state.hand_size), :itself, :itself, disabled: !player.in_turn? %>
    <% end %>

    <ul class="flex gap-1">
      <% state.hands[player.id].each do |card| %>
        <li class="">
          <%= form.label :value, value: card, class: "flex flex-col gap-0.5" do %>
            <span class="text-9xl"><%= unicode_for(card) %></span>
            <%= form.radio_button :value, card, disabled: !player.can_play? %>
          <% end %>
        </li>
      <% end %>
    </ul>

    <%= form.submit "play", class: "p-2 bg-green-300 text-4xl" %>
  <% end %>
<% end %>
