<%= turbo_frame_tag "state", class: "p-4 flex-1 flex flex-col perspective-normal", data: { controller: "board" } do %>
  <% if state.game_over? %>
    <span><strong class="font-semibold">winner:</strong> <%= state.winner.name %></span>

    <%= button_to "again", reset_path(seed: game.seed), method: :delete %>
  <% else %>
    <div class="flex-1">
      <ul class="flex gap-4 flex-wrap text-sm font-mono">
        <% game.players.each_with_index do |player, index| %>
          <li class="flex flex-col <%= player.in_turn? ? 'bg-amber-100' : '' %>">
            <span class="">
              <%= player.name %>
              <% case state.current_trick.to_h[player.id] || state.hand_size == 1 && local_assigns[:player].id != player.id && state.hands[player.id].first %>
                <% in nil %>
                <% in false %>
                <% in card %>
                <span class="<%= color_for(card) %> w-12 bg-white"><%= short_for(card) %></span>
              <% end %>
            </span>

            <span class="">
              <%= state.lives[player.id] %> ♥
              ·
              <% case [state.bids[player.id], state.tricks_won[player.id] || 0] %>
                <% in [nil, _] %>
                <span class="">0/?</span>
                <% in [a, b] if a < b %>
                <span class="text-red-500"><%= b %>/<%= a %></span>
                <% in [a, b] %>
                <span class=""><%= b %>/<%= a %></span>
              <% end %>
            </span>
          </li>
        <% end %>


        <li class="flex flex-col">
          <p>hand size: <%= state.hand_size %></p>
          <p>table bid: <%= state.bids.values.sum %> </p>
        </li>
      </ul>

      <details>
        <summary class="p-2">help</summary>
        <div class="flex flex-wrap">
          <% Deck.cards.each do |card, _| %>
            <span class="text-8xl <%= color_for(card) %>"><%= unicode_for(card) %></span>
          <% end %>
        </div>
        </details>

      <div class="flex">
        <% state.display_trick.reverse.each do |player, card| %>
          <span class="text-9xl <%= color_for(card) %> w-12 bg-white"><%= unicode_for(card) %></span>
        <% end %>
      </div>

      <ul class="bg-slate-300 h-64" data-board-target="table">
        <% state.current_trick.each_with_index do |(player, card), index| %>
          <li class="block transform-3d shadow-lg rounded-4xl absolute w-36 h-48 -top-18 -left-24" data-board-target="tableCard" data-card="<%= card %>" data-index="<%= index %>">
            <span class="flex flex-col gap-0.5 bg-[url(/classic.png)] w-36 h-48" style="<%= background_position_for(card) %>"></span>
          </li>
        <% end %>
      </ul>
    </div>

    <%= render partial: "games/form", locals: { state:, game:, player: } %>
  <% end %>
<% end %>
