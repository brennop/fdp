<%= turbo_frame_tag "state", class: "p-4 flex-1" do %>
  <p>round: <%= state.round %></p>

  <ul>
    <% game.players.each_with_index do |player, index| %>
      <li class="flex gap-1 items-center">
        <%= player.name %> - <%= state.lives[player.id] %>/ 5 ♥  - <%= state.tricks_won[player.id] || 0 %> / <%= state.bids[player.id] %>🪙
        <% if player.in_turn? %>
          <span class="w-2 h-2 bg-green-400 rounded-full inline-block"></span>
        <% end %>
      </li>
    <% end %>
  </ul>

  <% state.sorted_trick.each do |player, card| %>
    <span class="text-9xl"><%= unicode_for(card) %></span>
  <% end %>

  <%= render partial: "games/form", locals: { state:, game:, player: } %>
<% end %>
